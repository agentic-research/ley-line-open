{
  "version": "cloister/confinement/v1",
  "description": "confinement/v1 README §4 port and §3 network.connectLocal as lists (ley-line-open-e2c33f). `cases` pin canonicalization and confinementDigest; `meets` pin the meet (set intersection) of two documents, which is commutative; `meetRefusals` pin where the meet is undefined; every `rejects` input is refused by the parser, and by the schema where `schemaRefuses` is true.",
  "cases": [
    {
      "name": "port-scalar-is-the-pinned-vector",
      "description": "The pinned single-port vector, unchanged: the scalar form canonicalizes to itself, so its digest is the one CONFINEMENT_DIGESTS.blake3 already pins.",
      "input": {
        "credentialSource": "keychain://bundle-X-credentials",
        "fs": {
          "allow": [
            "/etc/hosts",
            {
              "mode": "rw",
              "path": "/var/lib/bundle-X/"
            }
          ]
        },
        "network": {
          "allowHosts": [
            "*.telemetry.example.com",
            "api.example.com"
          ]
        },
        "version": "cloister/confinement/v1",
        "port": {
          "address": "127.0.0.1",
          "bind": 8443
        }
      },
      "canonical": "{\n  \"credentialSource\": \"keychain://bundle-X-credentials\",\n  \"fs\": {\n    \"allow\": [\n      \"/etc/hosts\",\n      {\n        \"mode\": \"rw\",\n        \"path\": \"/var/lib/bundle-X/\"\n      }\n    ]\n  },\n  \"network\": {\n    \"allowHosts\": [\n      \"*.telemetry.example.com\",\n      \"api.example.com\"\n    ]\n  },\n  \"port\": {\n    \"address\": \"127.0.0.1\",\n    \"bind\": 8443\n  },\n  \"version\": \"cloister/confinement/v1\"\n}",
      "confinementDigest": "blake3-256:d9b5b7270bb6e5ec068aec92798dd76b0f71d1fe2640b3a09833b7742d51c617"
    },
