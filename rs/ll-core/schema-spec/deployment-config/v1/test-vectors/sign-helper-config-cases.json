      "host": "macos",
      "syntax": "json",
      "input": "{\"apiVersion\": \"config.leyline/v1\", \"kind\": \"SignHelperConfig\", \"auth\": {\"callerTokens\": {\"file\": \"/etc/leyline/caller-tokens\"}}, \"signAllow\": {\"callers\": {\"cloister\": [\"keychain://com.cloister/\"]}}, \"bind\": \"127.0.0.1:08786\"}",
      "field": "bind",
      "reason": "non-canonical-address",
      "schemaRefuses": true
    },
    {
      "name": "rate-limit-above-u32",
      "description": "Above 4294967295.",
      "host": "macos",
      "syntax": "json",
      "input": "{\"apiVersion\": \"config.leyline/v1\", \"kind\": \"SignHelperConfig\", \"auth\": {\"callerTokens\": {\"file\": \"/etc/leyline/caller-tokens\"}}, \"signAllow\": {\"callers\": {\"cloister\": [\"keychain://com.cloister/\"]}}, \"rateLimitPerSecond\": 4294967296}",
      "field": "rateLimitPerSecond",
