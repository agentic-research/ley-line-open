      "host": "macos",
      "syntax": "json",
      "input": "{\"apiVersion\": \"config.leyline/v1\", \"kind\": \"SignHelperConfig\", \"auth\": {\"callerTokens\": {\"file\": \"/etc/leyline/caller-tokens\"}}, \"signAllow\": {\"callers\": {\"cloister\": [\"keychain://com.cloister/\"]}}, \"resolveAllow\": [\"nope\"]}",
