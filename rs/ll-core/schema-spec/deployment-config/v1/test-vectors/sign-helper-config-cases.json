      "input": "{\"apiVersion\": \"config.leyline/v1\", \"kind\": \"SignHelperConfig\", \"auth\": {\"callerTokens\": \"cloister=tok\"}, \"signAllow\": {\"callers\": {\"cloister\": [\"keychain://com.cloister/\"]}}}",
