index 13f5c705..a886e1fe 100644
--- a/src/libkrun/src/lib.rs
+++ b/src/libkrun/src/lib.rs
@@ -634,6 +634,7 @@ pub unsafe extern "C" fn krun_set_root(ctx_id: u32, c_root_path: *const c_char)
                     }
                     v
                 },
+                custom_backend: None,
             });
         }
         Entry::Vacant(_) => return -libc::ENOENT,
@@ -738,6 +739,7 @@ pub unsafe extern "C" fn krun_add_virtiofs4(
                 shm_size: shm,
                 read_only,
                 virtual_entries,
+                custom_backend: None,
             });
         }
         Entry::Vacant(_) => return -libc::ENOENT,
@@ -746,6 +748,42 @@ pub unsafe extern "C" fn krun_add_virtiofs4(
     KRUN_SUCCESS
 }
 
+/// Re-export of the virtio-fs request types an embedder needs to implement a backend.
+#[cfg(not(any(feature = "tee", feature = "aws-nitro")))]
+pub use devices::virtio::fs as virtio_fs;
+#[cfg(not(any(feature = "tee", feature = "aws-nitro")))]
+pub use devices::virtio::linux_errno::linux_error;
+
+/// Rust-only API: add a virtio-fs device whose FUSE requests are answered by
+/// `backend`, running in this process, instead of by a host directory.
+#[cfg(not(any(feature = "tee", feature = "aws-nitro")))]
+pub fn krun_add_virtiofs_backend(
+    ctx_id: u32,
+    tag: &str,
+    shm_size: u64,
+    backend: std::sync::Arc<dyn devices::virtio::fs::dyn_fs::DynFileSystem>,
+) -> i32 {
+    match CTX_MAP.lock().unwrap().entry(ctx_id) {
+        Entry::Occupied(mut ctx_cfg) => {
+            ctx_cfg.get_mut().vmr.add_fs_device(FsDeviceConfig {
+                fs_id: tag.to_string(),
+                shared_dir: None,
+                semantics: PermissionSemantics::LinuxComplete,
+                shm_size: if shm_size > 0 {
+                    Some(shm_size as usize)
+                } else {
+                    None
+                },
+                read_only: false,
+                virtual_entries: Vec::new(),
+                custom_backend: Some(devices::virtio::fs::dyn_fs::CustomFsBackend(backend)),
+            });
+        }
+        Entry::Vacant(_) => return -libc::ENOENT,
+    }
+    KRUN_SUCCESS
+}
+
 #[allow(clippy::missing_safety_doc)]
 #[no_mangle]
 #[cfg(not(feature = "tee"))]
